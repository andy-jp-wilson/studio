#!/bin/bash
# studio-project: Studio's setup notes for a project, kept in
# .studio/project.json in the folder Claude Code is open in. Never moves,
# overwrites or deletes anything the person made; no folder layout is needed.
#
#   studio-project status [dir]
#       Prints this project's setup notes as JSON (.studio/project.json),
#       plus "computer": what's been confirmed on this computer. {} when unset.
#   studio-project set <key> <value> [dir]
#       Records one answer. Keys: figmaAccount, designSystemUrl,
#       designSystemName, targetFileUrl, targetFileName, template (done or
#       skipped: the project template in Figma). figmaAccount is also
#       remembered for this computer. Prints "set <key>".
#   studio-project done <step> [dir]
#       Marks a setup step done: connection, account, designSystem,
#       targetFile. Prints "done <step>".

COMPUTER="$HOME/.studio/setup.json"
cmd="$1"; shift

notes() { echo "$1/.studio/project.json"; }
read_json() { [ -f "$1" ] && jq -c . "$1" 2>/dev/null || echo '{}'; }

write_key() {  # file key value
  local f="$1" tmp; mkdir -p "$(dirname "$f")"
  tmp=$(mktemp) || return 1
  read_json "$f" | jq --arg k "$2" --arg v "$3" '.[$k] = $v' > "$tmp" && cat "$tmp" > "$f"
  rm -f "$tmp"
}

case "$cmd" in
  status)
    dir="${1:-$PWD}"
    jq -n --argjson p "$(read_json "$(notes "$dir")")" --argjson c "$(read_json "$COMPUTER")" --arg folder "$dir" \
      '{folder: $folder, project: $p, computer: $c}'
    ;;
  set)
    key="$1"; value="$2"; dir="${3:-$PWD}"
    case "$key" in figmaAccount|designSystemUrl|designSystemName|targetFileUrl|targetFileName|template) ;; *) echo "unknown-key $key"; exit 1 ;; esac
    write_key "$(notes "$dir")" "$key" "$value"
    [ "$key" = figmaAccount ] && write_key "$COMPUTER" figmaAccount "$value"
    echo "set $key"
    ;;
  done)
    step="$1"; dir="${2:-$PWD}"
    case "$step" in connection|account|designSystem|targetFile) ;; *) echo "unknown-step $step"; exit 1 ;; esac
    f=$(notes "$dir"); tmp=$(mktemp); mkdir -p "$(dirname "$f")"
    read_json "$f" | jq --arg s "$step" --arg t "$(date +%Y-%m-%d)" '.done[$s] = $t' > "$tmp" && cat "$tmp" > "$f"; rm -f "$tmp"
    case "$step" in connection|account) write_key "$COMPUTER" "$step" "$(date +%Y-%m-%d)" ;; esac
    echo "done $step"
    ;;
  *)
    sed -n '2,16p' "$0" | sed 's/^# \{0,1\}//'
    ;;
esac
