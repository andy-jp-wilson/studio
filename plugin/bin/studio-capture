#!/bin/bash
# studio-capture <url> <out.png> [width] [height]
# Takes a picture of one screen of the private preview with headless Chrome
# (no window opens). Prints "saved <file>" or "unavailable <reason>".

url="$1"; out="$2"; w="${3:-390}"; h="${4:-844}"
[ -z "$url" ] || [ -z "$out" ] && { echo "unavailable usage: studio-capture <url> <out.png> [width] [height]"; exit 0; }

for app in "/Applications/Google Chrome.app/Contents/MacOS/Google Chrome" \
           "/Applications/Microsoft Edge.app/Contents/MacOS/Microsoft Edge" \
           "/Applications/Brave Browser.app/Contents/MacOS/Brave Browser" \
           "/Applications/Chromium.app/Contents/MacOS/Chromium"; do
  [ -x "$app" ] && browser="$app" && break
done
[ -z "$browser" ] && { echo "unavailable no Chrome-style browser found"; exit 0; }

mkdir -p "$(dirname "$out")"
profile=$(mktemp -d)
# Hidden Chrome won't size a window below about 500px, so the screen is shown
# centred in a frame of the exact size on a wider page, then the picture is
# trimmed around the centre.
win_w=$(( w < 600 ? 600 : w ))
wrapper="$profile/frame.html"
printf '<!doctype html><html><body style="margin:0;background:#fff;display:flex;justify-content:center"><iframe src="%s" style="border:0;width:%spx;height:%spx;display:block;flex:none"></iframe></body></html>' "$url" "$w" "$h" > "$wrapper"
"$browser" --headless=new --disable-gpu --hide-scrollbars --no-first-run \
  --user-data-dir="$profile/chrome" --force-device-scale-factor=2 --virtual-time-budget=3000 \
  --window-size="$win_w,$h" --screenshot="$out" "file://$wrapper" >/dev/null 2>&1 &
pid=$!
# Safety cut-off: headless Chrome can hang; stop it after 20 seconds.
for _ in $(seq 1 40); do
  kill -0 "$pid" 2>/dev/null || break
  [ -s "$out" ] && { sleep 0.5; break; }   # picture saved; Chrome may not exit by itself
  sleep 0.5
done
kill "$pid" 2>/dev/null; wait "$pid" 2>/dev/null
rm -rf "$profile"
[ -s "$out" ] && [ "$win_w" != "$w" ] && sips -c $((h*2)) $((w*2)) "$out" >/dev/null 2>&1
[ -s "$out" ] && echo "saved $out" || echo "unavailable the browser could not take the picture"
