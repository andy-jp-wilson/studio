#!/bin/bash
# studio-team: the team's Studio settings, kept in Claude Code's user
# settings (~/.claude/settings.json, under "env") so every session sees them.
# Only Studio's own settings are ever read or written; nothing else changes.
#
#   studio-team show
#       Prints the Studio settings currently set, as KEY=value lines,
#       or "none".
#   studio-team json
#       Prints the current settings as one JSON object (for the team form).
#   studio-team read <file>
#       Reads a team file (*.studio-team.json) and prints its settings as JSON,
#       or "not-a-team-file". Changes nothing.
#   studio-team export [folder]
#       Saves the current settings as a team file to share, in [folder]
#       (default: Desktop, else home). Prints "saved <path>".
#   studio-team form
#       Opens the team settings form in the Studio panel (the Studio band
#       and panel watch for this). Prints "form".
#   studio-team set <KEY> <value>
#       Sets one Studio setting (an empty value removes it). Keeps a copy of
#       the settings file first (settings.json.studio-backup). Prints
#       "set <KEY>" or "removed <KEY>". Takes effect in new sessions.
#
# Keys:
#   STUDIO_TEAM_NAME           the team's name, for Studio's messages
#   STUDIO_ALLOWED_ORGS        GitHub owners work may be uploaded to, comma-separated
#   STUDIO_DESIGN_SYSTEMS      design systems, "Name | link" separated by ";"
#   STUDIO_FIGMA_WRITE_PLACES  Figma teams or folders Studio may write to (not enforced yet)
#   STUDIO_PROJECTS_FOLDER     where new projects go

KEYS="STUDIO_TEAM_NAME STUDIO_ALLOWED_ORGS STUDIO_DESIGN_SYSTEMS STUDIO_FIGMA_WRITE_PLACES STUDIO_PROJECTS_FOLDER"
file="$HOME/.claude/settings.json"
cmd="$1"; shift

case "$cmd" in
  show)
    out=$( [ -f "$file" ] && jq -r --arg keys "$KEYS" '
      ($keys | split(" ")) as $k | (.env // {}) | to_entries[] | select(.key as $x | $k | index($x)) | "\(.key)=\(.value)"' "$file" 2>/dev/null)
    [ -n "$out" ] && printf '%s\n' "$out" || echo "none"
    ;;
  set)
    key="$1"; value="$2"
    case " $KEYS " in *" $key "*) ;; *) echo "unknown-key $key"; exit 1 ;; esac
    mkdir -p "$(dirname "$file")"
    [ -f "$file" ] || echo '{}' > "$file"
    jq empty "$file" 2>/dev/null || { echo "unreadable-settings $file"; exit 1; }
    cp "$file" "$file.studio-backup"
    tmp=$(mktemp) || exit 1
    if [ -z "$value" ]; then
      jq --arg k "$key" 'if .env then .env |= del(.[$k]) else . end' "$file" > "$tmp" && cat "$tmp" > "$file" && echo "removed $key"
    else
      jq --arg k "$key" --arg v "$value" '.env = ((.env // {}) + {($k): $v})' "$file" > "$tmp" && cat "$tmp" > "$file" && echo "set $key"
    fi
    rm -f "$tmp"
    ;;
  json)
    [ -f "$file" ] && jq -c '(.env // {}) as $e | {teamName: ($e.STUDIO_TEAM_NAME // ""), uploadPlaces: ($e.STUDIO_ALLOWED_ORGS // ""),
      projectsFolder: ($e.STUDIO_PROJECTS_FOLDER // ""), figmaWritePlaces: ($e.STUDIO_FIGMA_WRITE_PLACES // ""),
      designSystems: (($e.STUDIO_DESIGN_SYSTEMS // "") | split(";") | map(split("|") | map(gsub("^ +| +$"; "")) | select(.[0] != "" or (.[1] // "") != "") | {name: .[0], link: (.[1] // "")}))}' "$file" 2>/dev/null \
      || echo '{"teamName":"","uploadPlaces":"","projectsFolder":"","figmaWritePlaces":"","designSystems":[]}'
    ;;
  read)
    f="${1/#\~/$HOME}"
    jq -e -c 'select(.studioTeam) | {teamName: (.teamName // ""), uploadPlaces: (.uploadPlaces // ""), projectsFolder: (.projectsFolder // ""),
      figmaWritePlaces: (.figmaWritePlaces // ""), designSystems: [(.designSystems // [])[] | {name: (.name // ""), link: (.link // "")}]}' "$f" 2>/dev/null \
      || echo "not-a-team-file"
    ;;
  export)
    dir="${1:-}"; dir="${dir/#\~/$HOME}"
    [ -z "$dir" ] && { [ -d "$HOME/Desktop" ] && dir="$HOME/Desktop" || dir="$HOME"; }
    cur=$("$0" json)
    name=$(printf '%s' "$cur" | jq -r '.teamName' | tr 'A-Z' 'a-z' | sed -E 's/[^a-z0-9]+/-/g; s/^-+|-+$//g')
    out="$dir/${name:-team}.studio-team.json"
    printf '%s' "$cur" | jq '{studioTeam: 1} + .' > "$out" && echo "saved $out"
    ;;
  form)
    echo "form"
    ;;
  *)
    sed -n '2,37p' "$0" | sed 's/^# \{0,1\}//'
    ;;
esac
