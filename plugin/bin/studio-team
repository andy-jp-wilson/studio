#!/bin/bash
# studio-team: the team's settings for Studio, kept in Claude Code's
# user settings (~/.claude/settings.json, under "env") so every session sees
# them. Only Studio's own settings are ever read or written.
#
#   studio-team show
#       Prints the Studio settings currently set, as KEY=value lines, or "none".
#   studio-team read <file>
#       Reads a team file (*.studio-team.json) someone shared and prints the
#       settings in it as KEY=value lines (design systems as "Name | link; …"),
#       or "not-a-team-file". Changes nothing.
#   studio-team export [folder]
#       Saves the team settings as a team file to share, in [folder]
#       (default: Desktop, else home). Prints "saved <path>".
#   studio-team set <KEY> <value>
#       Sets one Studio setting (an empty value removes it). Keeps a copy of
#       the settings file first (settings.json.studio-backup). Prints
#       "set <KEY>" or "removed <KEY>". Takes effect in new sessions.
#
# Keys:
#   STUDIO_DESIGN_SYSTEMS  design systems, "Name | link" separated by ";"
#   STUDIO_TEAM_LOGO       Figma link to the team's logo component (with node-id),
#                          shown on a charcoal strip on each project's cover
#   STUDIO_CANVAS_COLOR    the colour of every page's canvas, e.g. #F5F5F5
#                          (Studio uses #F5F5F5 when it isn't set)
#   STUDIO_ALLOWED_ORGS    GitHub owners work may be uploaded to, comma-separated
#                          (used by Studio's upload check; set by a team admin)

KEYS="STUDIO_DESIGN_SYSTEMS STUDIO_TEAM_LOGO STUDIO_CANVAS_COLOR STUDIO_ALLOWED_ORGS"
file="$HOME/.claude/settings.json"
cmd="$1"; shift

case "$cmd" in
  show)
    out=$( [ -f "$file" ] && jq -r --arg keys "$KEYS" '
      ($keys | split(" ")) as $k | (.env // {}) | to_entries[] | select(.key as $x | $k | index($x)) | "\(.key)=\(.value)"' "$file" 2>/dev/null)
    [ -n "$out" ] && printf '%s\n' "$out" || echo "none"
    ;;
  set)
    key="$1"; value="$2"
    case " $KEYS " in *" $key "*) ;; *) echo "unknown-key $key"; exit 1 ;; esac
    if [ -n "$value" ]; then
      case "$key" in
        STUDIO_CANVAS_COLOR)
          printf '%s' "$value" | grep -Eq '^#[0-9A-Fa-f]{6}$' || { echo "not-a-colour $value"; exit 1; }
          value=$(printf '%s' "$value" | tr 'a-f' 'A-F') ;;
        STUDIO_TEAM_LOGO)
          printf '%s' "$value" | grep -Eq '^https://(www\.)?figma\.com/(design|file)/[A-Za-z0-9]+/[^ ]*node-id=[0-9]+[-:][0-9]+' || { echo "not-a-figma-component-link $value"; exit 1; } ;;
      esac
    fi
    mkdir -p "$(dirname "$file")"
    [ -f "$file" ] || echo '{}' > "$file"
    jq empty "$file" 2>/dev/null || { echo "unreadable-settings $file"; exit 1; }
    cp "$file" "$file.studio-backup"
    tmp=$(mktemp) || exit 1
    if [ -z "$value" ]; then
      jq --arg k "$key" 'if .env then .env |= del(.[$k]) else . end' "$file" > "$tmp" && cat "$tmp" > "$file" && echo "removed $key"
    else
      jq --arg k "$key" --arg v "$value" '.env = ((.env // {}) + {($k): $v})' "$file" > "$tmp" && cat "$tmp" > "$file" && echo "set $key"
    fi
    rm -f "$tmp"
    ;;
  read)
    f="${1/#\~/$HOME}"
    jq -e -r 'select(.studioTeam) |
      ([(.designSystems // [])[] | select((.name // "") != "" or (.link // "") != "") | "\(.name // "") | \(.link // "")"] | join("; ")) as $ds |
      [ (if $ds != "" then "STUDIO_DESIGN_SYSTEMS=\($ds)" else empty end),
        (if (.teamLogo // "") != "" then "STUDIO_TEAM_LOGO=\(.teamLogo)" else empty end),
        (if (.canvasColor // "") != "" then "STUDIO_CANVAS_COLOR=\(.canvasColor)" else empty end) ] |
      if length > 0 then .[] else "none" end' "$f" 2>/dev/null \
      || echo "not-a-team-file"
    ;;
  export)
    dir="${1:-}"; dir="${dir/#\~/$HOME}"
    [ -z "$dir" ] && { [ -d "$HOME/Desktop" ] && dir="$HOME/Desktop" || dir="$HOME"; }
    env=$( [ -f "$file" ] && jq -c '.env // {}' "$file" 2>/dev/null); [ -n "$env" ] || env='{}'
    out="$dir/team.studio-team.json"
    printf '%s' "$env" | jq '{studioTeam: 1,
      designSystems: ((.STUDIO_DESIGN_SYSTEMS // "") | split(";") | map(split("|") | map(gsub("^ +| +$"; "")) | select(.[0] != "" or (.[1] // "") != "") | {name: .[0], link: (.[1] // "")}))}
      + (if (.STUDIO_TEAM_LOGO // "") != "" then {teamLogo: .STUDIO_TEAM_LOGO} else {} end)
      + (if (.STUDIO_CANVAS_COLOR // "") != "" then {canvasColor: .STUDIO_CANVAS_COLOR} else {} end)' > "$out" && echo "saved $out"
    ;;
  *)
    sed -n '2,27p' "$0" | sed 's/^# \{0,1\}//'
    ;;
esac
