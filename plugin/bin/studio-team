#!/bin/bash
# studio-team: the team's design systems for Studio, kept in Claude Code's
# user settings (~/.claude/settings.json, under "env") so every session sees
# them. Only Studio's own settings are ever read or written.
#
#   studio-team show
#       Prints the Studio settings currently set, as KEY=value lines, or "none".
#   studio-team read <file>
#       Reads a team file (*.studio-team.json) someone shared and prints its
#       design systems as "Name | link; …", or "not-a-team-file". Changes nothing.
#   studio-team export [folder]
#       Saves the design systems as a team file to share, in [folder]
#       (default: Desktop, else home). Prints "saved <path>".
#   studio-team set <KEY> <value>
#       Sets one Studio setting (an empty value removes it). Keeps a copy of
#       the settings file first (settings.json.studio-backup). Prints
#       "set <KEY>" or "removed <KEY>". Takes effect in new sessions.
#
# Keys:
#   STUDIO_DESIGN_SYSTEMS  design systems, "Name | link" separated by ";"
#   STUDIO_ALLOWED_ORGS    GitHub owners work may be uploaded to, comma-separated
#                          (used by Studio's upload check; set by a team admin)

KEYS="STUDIO_DESIGN_SYSTEMS STUDIO_ALLOWED_ORGS"
file="$HOME/.claude/settings.json"
cmd="$1"; shift

case "$cmd" in
  show)
    out=$( [ -f "$file" ] && jq -r --arg keys "$KEYS" '
      ($keys | split(" ")) as $k | (.env // {}) | to_entries[] | select(.key as $x | $k | index($x)) | "\(.key)=\(.value)"' "$file" 2>/dev/null)
    [ -n "$out" ] && printf '%s\n' "$out" || echo "none"
    ;;
  set)
    key="$1"; value="$2"
    case " $KEYS " in *" $key "*) ;; *) echo "unknown-key $key"; exit 1 ;; esac
    mkdir -p "$(dirname "$file")"
    [ -f "$file" ] || echo '{}' > "$file"
    jq empty "$file" 2>/dev/null || { echo "unreadable-settings $file"; exit 1; }
    cp "$file" "$file.studio-backup"
    tmp=$(mktemp) || exit 1
    if [ -z "$value" ]; then
      jq --arg k "$key" 'if .env then .env |= del(.[$k]) else . end' "$file" > "$tmp" && cat "$tmp" > "$file" && echo "removed $key"
    else
      jq --arg k "$key" --arg v "$value" '.env = ((.env // {}) + {($k): $v})' "$file" > "$tmp" && cat "$tmp" > "$file" && echo "set $key"
    fi
    rm -f "$tmp"
    ;;
  read)
    f="${1/#\~/$HOME}"
    jq -e -r 'select(.studioTeam) | [(.designSystems // [])[] | select((.name // "") != "" or (.link // "") != "") | "\(.name // "") | \(.link // "")"] | join("; ")' "$f" 2>/dev/null \
      || echo "not-a-team-file"
    ;;
  export)
    dir="${1:-}"; dir="${dir/#\~/$HOME}"
    [ -z "$dir" ] && { [ -d "$HOME/Desktop" ] && dir="$HOME/Desktop" || dir="$HOME"; }
    ds=$( [ -f "$file" ] && jq -r '.env.STUDIO_DESIGN_SYSTEMS // ""' "$file" 2>/dev/null)
    out="$dir/team.studio-team.json"
    printf '%s' "$ds" | jq -R '{studioTeam: 1, designSystems: (split(";") | map(split("|") | map(gsub("^ +| +$"; "")) | select(.[0] != "" or (.[1] // "") != "") | {name: .[0], link: (.[1] // "")}))}' > "$out" && echo "saved $out"
    ;;
  *)
    sed -n '2,22p' "$0" | sed 's/^# \{0,1\}//'
    ;;
esac
