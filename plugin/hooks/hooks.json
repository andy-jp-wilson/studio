{
  "description": "Studio: the band above the prompt and the Studio panel (a mod) that follow the story, plus safety hooks: design system files in Figma are never changed and Claude's first change to each Figma file in a conversation is asked about, work stays on this computer unless the person approves an upload (or it goes to a team-listed GitHub), a hidden snapshot before Claude's first change to files in each request, plain-language notes when a step fails, and pre-approval for Studio's own helpers and story tool.",
  "modules": [
    "./studio.js"
  ],
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/guard-uploads.sh\"",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "mcp__.*__(use_figma|generate_figma_design|upload_assets|send_code_to_figma|add_code_connect_map|send_code_connect_mappings)",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/guard-figma.sh\"",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Bash|mcp__studio__story",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/allow-studio-tools.sh\"",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Edit|Write|NotebookEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/snapshot.sh\"",
            "timeout": 20
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/calm-errors.sh\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "mcp__.*__(use_figma|generate_figma_design|upload_assets|send_code_to_figma|add_code_connect_map|send_code_connect_mappings)",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/guard-figma.sh\" record",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
